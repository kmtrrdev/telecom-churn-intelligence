# Free Hugging Face token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat/extraction model, routed through HF Inference Providers (provider="auto").
# Default is a strong ~671B open model with good Arabic + reasoning quality.
# Fallbacks if unavailable on your account/region:
#   meta-llama/Llama-3.3-70B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
CHAT_MODEL_ID=deepseek-ai/DeepSeek-V3-0324

# Friendly name shown in the app UI (purely cosmetic)
CHAT_MODEL_DISPLAY_NAME=DeepSeek V3
